# ============================================================
# Quick Prescription Form — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Telegram ---
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Telegram chat ID where prescriptions will be sent.
# To find your chat ID: message your bot, then visit:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Flask ---
# Set to "true" only during local development
FLASK_DEBUG=false

# Port to listen on (default: 5000)
PORT=5000
